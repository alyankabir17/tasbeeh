# PostgreSQL connection string
# Get one free from: https://supabase.com  or  https://neon.tech  or  https://railway.app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth.js — generate with: openssl rand -base64 32
# Set BOTH for compatibility (NEXTAUTH_SECRET for local, AUTH_SECRET for v5 production)
NEXTAUTH_SECRET=""
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
